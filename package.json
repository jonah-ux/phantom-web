{
  "name": "phantom-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint --threads 2",
    "preview": "vite preview --host 127.0.0.1 --port 6174 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --maxWorkers=2",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "description": "A fictional internet with a coherent, interactive mystery.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonah-ux/phantom-web.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
